<Window x:Class="SpringKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpringKey"
        xmlns:ViewModel="clr-namespace:SpringKey.ViewModel"
        mc:Ignorable="d"
        Title="SpringKey" Height="700" Width="1000"
        Background="{StaticResource ThemeColor}">
    <Window.DataContext>
        <ViewModel:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="UserKey" Margin="0,0,0,10" Foreground="#FFCCCCCC" FontSize="12"/>
                        <PasswordBox Height="30" Style="{StaticResource UserKeyPassword}">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <TextBlock Text="Enter" FontSize="10" Foreground="#888" Margin="0,10,0,0" TextAlignment="Right"/>
                    </StackPanel>
                    
                </Border>
                
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="#D4D4D4" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="共 0 个密码项" Foreground="#D4D4D4" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Prompt}" Foreground="Gray" FontSize="12" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</Window>
