<Window x:Class="SpringKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpringKey"
        xmlns:vm="clr-namespace:SpringKey.ViewModel"
        xmlns:Helpers="clr-namespace:SpringKey.Helpers"
        mc:Ignorable="d"
        Title="SpringKey" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ThemeColor}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Helpers:GroupEditVisibilityConverter x:Key="GroupEditVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0"
                Background="{StaticResource SideBarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15" Height="110"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Visibility="{Binding LoginVisibility}">
                    <StackPanel>
                        <TextBlock Text="UserKey" Margin="0,0,0,10" Foreground="#FFCCCCCC" FontSize="12" />

                        <TextBox Style="{StaticResource StyleUserKeyPassword}" Height="30"
                                 Helpers:MaskedTextBoxHelper.IsEnabled="True"
                                 Helpers:MaskedTextBoxHelper.Password="{Binding UserKey, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Text="Enter" FontSize="10" Foreground="#888" Margin="0,10,0,0" TextAlignment="Right" />
                    </StackPanel>
                </Border>

                <!--用户界面-->
                <Border Grid.Row="0" Padding="15,15,15,0" Height="110"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Visibility="{Binding UserVisibility}">
                    <StackPanel>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="32" Height="32"
                                     Fill="{StaticResource ProfilePictureColor}" />
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="White" Text="{Binding UserInitial}" />

                            <!-- 查看模式 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding IsEditingUserName, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="{Binding UserName}" FontSize="14"
                                           Foreground="White" />
                                <TextBlock Text="使用中" FontSize="10" Foreground="#4EC9B0" />
                            </StackPanel>

                            <!-- 编辑模式 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding IsEditingUserName, Converter={StaticResource BoolToVis}}">
                                <TextBox x:Name="RenameTextBox"
                                         Text="{Binding EditingUserName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" Foreground="White"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0" CaretBrush="White"
                                         IsVisibleChanged="RenameTextBox_IsVisibleChanged">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ConfirmEditUserNameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelEditUserNameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="使用中" FontSize="10" Foreground="#4EC9B0" />
                            </StackPanel>

                            <!-- 查看模式按钮 -->
                            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource StyleIcoButton}"
                                    Visibility="{Binding IsEditingUserName, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                    Command="{Binding RenameUserCommand}">
                                <Path Data="{StaticResource IconEditGeometry}" Fill="{StaticResource IcoColor}"
                                      Height="12" Width="12" Stretch="Uniform" />
                            </Button>

                            <!-- 编辑模式按钮 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal"
                                        Visibility="{Binding IsEditingUserName, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource StyleIcoButton}" Margin="0,0,2,0"
                                        Command="{Binding ConfirmEditUserNameCommand}">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="#4EC9B0" />
                                </Button>
                                <Button Style="{StaticResource StyleIcoButton}"
                                        Command="{Binding CancelEditUserNameCommand}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource IcoColor}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button Content="退出登录" Margin="0,20,0,0" HorizontalAlignment="Left" FontSize="11" Width="70"
                                Height="28"
                                Style="{StaticResource StyleIcoButton}"
                                Command="{Binding SignOutCommand}" />

                    </StackPanel>
                </Border>

                <!-- 分组头部 -->
                <Grid Grid.Row="1" Margin="15,10,10,0" Height="24"
                      Visibility="{Binding UserVisibility}">
                    <TextBlock Text="分组" Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Visibility="{Binding IsAddingGroup, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <Button Content="+" Style="{StaticResource StyleIcoButton}" Width="24" Height="24"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Visibility="{Binding IsAddingGroup, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Command="{Binding AddGroupCommand}" />
                    <!-- 添加分组输入 -->
                    <Grid Visibility="{Binding IsAddingGroup, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddGroupTextBox" Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Foreground="White" CaretBrush="White"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 IsVisibleChanged="AddGroupTextBox_IsVisibleChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmAddGroupCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelAddGroupCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StyleIcoButton}" Margin="2,0,0,0"
                                    Command="{Binding ConfirmAddGroupCommand}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#4EC9B0" />
                            </Button>
                            <Button Style="{StaticResource StyleIcoButton}"
                                    Command="{Binding CancelAddGroupCommand}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource IcoColor}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ListBox x:Name="GroupListBox" Grid.Row="2" BorderThickness="0" Margin="0,5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding GroupIndex}"
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent"
                         Visibility="{Binding UserVisibility}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 查看模式 -->
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                           Margin="10,5">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource GroupEditVis}" ConverterParameter="Invert">
                                            <Binding />
                                            <Binding Path="DataContext.EditingGroupOldName"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            <Binding Path="DataContext.IsRenamingGroup"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <!-- 编辑模式 -->
                                <TextBox Grid.Column="0" VerticalAlignment="Center" Margin="10,5"
                                         Text="{Binding DataContext.EditingGroupNewName, RelativeSource={RelativeSource AncestorType=ListBox}, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" Foreground="White" CaretBrush="White"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsVisibleChanged="RenameGroupTextBox_IsVisibleChanged"
                                         LostFocus="RenameGroupTextBox_LostFocus">
                                    <TextBox.Visibility>
                                        <MultiBinding Converter="{StaticResource GroupEditVis}">
                                            <Binding />
                                            <Binding Path="DataContext.EditingGroupOldName"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            <Binding Path="DataContext.IsRenamingGroup"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </TextBox.Visibility>
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.ConfirmRenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <KeyBinding Key="Escape"
                                                    Command="{Binding DataContext.CancelRenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- ... 按钮 -->
                                <Button Grid.Column="1" Style="{StaticResource StyleListActionButton}"
                                        Width="20" Height="20" VerticalAlignment="Center"
                                        Click="GroupMenuButton_Click">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource GroupEditVis}" ConverterParameter="Button">
                                            <Binding />
                                            <Binding Path="DataContext.EditingGroupOldName"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            <Binding Path="DataContext.IsRenamingGroup"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </Button.Visibility>
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#858585" FontSize="12" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名" Click="GroupRenameMenuItem_Click" />
                                            <MenuItem Header="删除分组" Click="GroupDeleteMenuItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- 编辑模式按钮 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <StackPanel.Visibility>
                                        <MultiBinding Converter="{StaticResource GroupEditVis}">
                                            <Binding />
                                            <Binding Path="DataContext.EditingGroupOldName"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            <Binding Path="DataContext.IsRenamingGroup"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </StackPanel.Visibility>
                                    <Button Style="{StaticResource StyleIcoButton}" Margin="0,0,2,0"
                                            Command="{Binding DataContext.ConfirmRenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="#4EC9B0" />
                                    </Button>
                                    <Button Style="{StaticResource StyleIcoButton}"
                                            Command="{Binding DataContext.CancelRenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource IcoColor}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <ListView Grid.Row="0" ItemsSource="{Binding Keys}"
                      Background="Transparent" BorderThickness="0"
                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource StyleListViewItem}">
                        <Setter Property="Helpers:ListViewItemClickBehavior.Command"
                                Value="{Binding DataContext.ItemClickCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Height="27">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Visibility="{Binding ShowVisibility}"
                                        Background="{StaticResource LoveColor}" Width="2" Margin="2,0,5,0" />
                                <Border Grid.Column="1" Background="#264F78" CornerRadius="2"
                                        Padding="6,1" Margin="0,0,12,0"
                                        Height="20">
                                    <TextBlock Text="tage" Foreground="#FFFFFF" FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#D4D4D4" FontSize="13"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Margin="0,0,15,0"
                                            Visibility="{Binding ShowVisibility}">
                                    <TextBlock Text="Account:" Foreground="#6A9955" FontSize="12" Margin="0,0,5,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Account}" Foreground="#9CDCFE" FontFamily="Consolas"
                                               FontSize="13" VerticalAlignment="Center" />
                                    <Button Margin="10,0,0,0"
                                            Width="37"
                                            Padding="0"
                                            Style="{StaticResource StyleCopyButton}"
                                            Command="{Binding DataContext.CopyClickCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding CopyText}" Foreground="Black" FontSize="11" />
                                    </Button>
                                </StackPanel>


                                <Button Style="{StaticResource StyleListActionButton}"
                                        Grid.Column="4"
                                        Height="20" Width="20"
                                        Click="KeyMenuButton_Click">
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="#858585"
                                               FontSize="12" />
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="KeyContextMenu_Opened"/>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="#D4D4D4" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="共 0 个密码项" Foreground="#D4D4D4" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Prompt}" Foreground="Gray" FontSize="12" Margin="15,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding UserVisibility}">
                        <Button Style="{StaticResource StyleIcoButton}" Margin="0,0,8,0"
                                Command="{Binding ImportExportCommand}">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource StyleIcoButton}" Margin="0,0,8,0"
                                Command="{Binding AddFileCommand}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>

    </Grid>
</Window>