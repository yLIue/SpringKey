<Window x:Class="SpringKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpringKey"
        xmlns:vm="clr-namespace:SpringKey.ViewModel"
        xmlns:Helpers="clr-namespace:SpringKey.Helpers"
        mc:Ignorable="d"
        Title="SpringKey" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ThemeColor}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0"
                Background="{StaticResource SideBarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15" Height="110"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Visibility="{Binding LoginVisibility}">
                    <StackPanel>
                        <TextBlock Text="UserKey" Margin="0,0,0,10" Foreground="#FFCCCCCC" FontSize="12" />

                        <TextBox Style="{StaticResource StyleUserKeyPassword}" Height="30"
                                 Helpers:MaskedTextBoxHelper.IsEnabled="True"
                                 Helpers:MaskedTextBoxHelper.Password="{Binding UserKey, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Text="Enter" FontSize="10" Foreground="#888" Margin="0,10,0,0" TextAlignment="Right" />
                    </StackPanel>
                </Border>

                <!--用户界面-->
                <Border Grid.Row="0" Padding="15,15,15,0" Height="110"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Visibility="{Binding UserVisibility}">
                    <StackPanel>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="32" Height="32"
                                     Fill="{StaticResource ProfilePictureColor}" />
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="White" Text="{Binding UserInitial}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding UserName}" FontSize="14"
                                           Foreground="White" />
                                <TextBlock Text="使用中" FontSize="10" Foreground="#4EC9B0" />
                            </StackPanel>

                            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource StyleIcoButton}">
                                <Path Data="{StaticResource IconEditGeometry}" Fill="{StaticResource IcoColor}"
                                      Height="12" Width="12" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <Button Content="退出登录" Margin="0,20,0,0" HorizontalAlignment="Left" FontSize="11" Width="70"
                                Height="28"
                                Style="{StaticResource StyleIcoButton}"
                                Command="{Binding SignOutCommand}" />

                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" BorderThickness="0" Margin="0,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding GroupIndex}"
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent" />

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <ListView Grid.Row="0" ItemsSource="{Binding Keys}"
                      Background="Transparent" BorderThickness="0"
                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource StyleListViewItem}">
                        <Setter Property="Helpers:ListViewItemClickBehavior.Command"
                                Value="{Binding DataContext.ItemClickCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Height="27">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Visibility="{Binding ShowVisibility}"
                                        Background="{StaticResource LoveColor}" Width="2" Margin="2,0,5,0" />
                                <Border Grid.Column="1" Background="#264F78" CornerRadius="2"
                                        Padding="6,1" Margin="0,0,12,0"
                                        Height="20">
                                    <TextBlock Text="tage" Foreground="#FFFFFF" FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#D4D4D4" FontSize="13"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Margin="0,0,15,0"
                                            Visibility="{Binding ShowVisibility}">
                                    <TextBlock Text="Account:" Foreground="#6A9955" FontSize="12" Margin="0,0,5,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Account}" Foreground="#9CDCFE" FontFamily="Consolas"
                                               FontSize="13" VerticalAlignment="Center" />
                                    <Button Margin="10,0,0,0"
                                            Width="37"
                                            Padding="0"
                                            Style="{StaticResource StyleCopyButton}"
                                            Command="{Binding DataContext.CopyClickCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding CopyText}" Foreground="Black" FontSize="11" />
                                    </Button>
                                </StackPanel>


                                <Button Style="{StaticResource StyleListActionButton}"
                                        Grid.Column="4"
                                        Height="20" Width="20">
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="#858585"
                                               FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="#D4D4D4" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="共 0 个密码项" Foreground="#D4D4D4" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Prompt}" Foreground="Gray" FontSize="12" Margin="15,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding UserVisibility}">
                        <Button Style="{StaticResource StyleIcoButton}" Margin="0,0,8,0"
                                Command="{Binding AddFileCommand}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>

    </Grid>
</Window>