<Window x:Class="SpringKey.View.AddFileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SpringKey.ViewModel"
        mc:Ignorable="d"
        Title="添加项" Height="620" Width="420"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ThemeColor}">
    <Window.DataContext>
        <vm:AddFileViewModel />
    </Window.DataContext>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Title -->
        <TextBox Grid.Row="0" Margin="0,0,0,20"
                 Style="{StaticResource StyleAddFileTitle}"
                 FontSize="20" FontWeight="SemiBold"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Row 1: Account -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="账号" Style="{StaticResource StyleAddKeyText}" />
            <TextBox Style="{StaticResource StyleAddKeyInput}"
                     Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Row 2: Password with history dropdown -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="密码" Style="{StaticResource StyleAddKeyText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource StyleAddKeyInput}"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleButton x:Name="PasswordHistoryToggle" Grid.Column="1"
                              Width="22" Margin="2,0,0,0"
                              IsChecked="{Binding IsPasswordHistoryOpen}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#3C3C3C" />
                            <Setter Property="Foreground" Value="#CCCCCC" />
                            <Setter Property="BorderBrush" Value="#3C3C3C" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="FontSize" Value="9" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PasswordPrevList.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="BorderBrush" Value="#007ACC" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4A4A4A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <TextBlock Text="▼" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsPasswordHistoryOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=PasswordHistoryToggle}"
                       Placement="Bottom"
                       StaysOpen="False">
                    <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                            CornerRadius="3" Width="300" MaxHeight="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Padding="10,8"
                                    BorderBrush="#444444" BorderThickness="0,0,0,1">
                                <TextBlock Text="历史密码" FontSize="11"
                                           Foreground="#888888" />
                            </Border>

                            <!-- List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PasswordPrevList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="{Binding}"
                                                        Foreground="#CCCCCC"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding DataContext.SelectPrevPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Padding" Value="8,4" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#3C3C3C" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="1" Content="✕"
                                                        Foreground="#888888" FontSize="10"
                                                        Width="24" Height="24"
                                                        Command="{Binding DataContext.DeletePrevPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#4A4A4A" />
                                                                                <Setter Property="Foreground" Value="#CCCCCC" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <!-- Row 3: Place -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="网址/App" Style="{StaticResource StyleAddKeyText}" />
            <TextBox Style="{StaticResource StyleAddKeyInput}"
                     Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Row 4: Description -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="描述" Style="{StaticResource StyleAddKeyText}" />
            <TextBox Style="{StaticResource StyleAddKeyInput}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="60"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Width="6">
                                                    <Thumb.Style>
                                                        <Style TargetType="Thumb">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#555555"
                                                                                CornerRadius="2" />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Thumb.Style>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Row 5: Binding -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="绑定" Style="{StaticResource StyleAddKeyText}" Margin="0" />
                <Button Grid.Column="1" Content="+ 添加"
                        Foreground="#4EC9B0" FontSize="11"
                        Command="{Binding AddBindingCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3C3C3C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding BindingList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      IsEditable="True"
                                      Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="#CCCCCC" FontSize="12"
                                      Margin="0,0,6,0">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background" Value="#3C3C3C" />
                                        <Setter Property="BorderBrush" Value="#3C3C3C" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="PART_EditableTextBox"
                                                                     Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     Foreground="#CCCCCC"
                                                                     CaretBrush="#CCCCCC"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Margin="{TemplateBinding Padding}"
                                                                     VerticalAlignment="Center" />
                                                            <ToggleButton Grid.Column="1"
                                                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ToggleButton">
                                                                                    <Border Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                                                                          VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="#4A4A4A" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                                <TextBlock Text="▼" FontSize="8"
                                                                           Foreground="#888888"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center" />
                                                            </ToggleButton>
                                                            <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   Placement="Bottom"
                                                                   StaysOpen="False">
                                                                <Border Background="#2D2D2D"
                                                                        BorderBrush="#555555"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        MinWidth="100">
                                                                    <Border.Resources>
                                                                        <Style TargetType="ComboBoxItem">
                                                                            <Setter Property="FontSize" Value="12" />
                                                                            <Setter Property="Padding" Value="8,5" />
                                                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                                                        <Border x:Name="itemBd"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="itemBd" Property="Background" Value="#3C3C3C" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                                <Setter TargetName="itemBd" Property="Background" Value="#4A4A4A" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                        <Style TargetType="ScrollBar">
                                                                            <Setter Property="Width" Value="6" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ScrollBar">
                                                                                        <Border Background="Transparent">
                                                                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                                                <Track.Thumb>
                                                                                                    <Thumb Width="6">
                                                                                                        <Thumb.Style>
                                                                                                            <Style TargetType="Thumb">
                                                                                                                <Setter Property="Template">
                                                                                                                    <Setter.Value>
                                                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                                                            <Border Background="#555555"
                                                                                                                                    CornerRadius="2" />
                                                                                                                        </ControlTemplate>
                                                                                                                    </Setter.Value>
                                                                                                                </Setter>
                                                                                                            </Style>
                                                                                                        </Thumb.Style>
                                                                                                    </Thumb>
                                                                                                </Track.Thumb>
                                                                                            </Track>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </Border.Resources>
                                                                    <ItemsPresenter />
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBoxItem Content="phone" />
                                <ComboBoxItem Content="email" />
                                <ComboBoxItem Content="github" />
                                <ComboBoxItem Content="wechat" />
                                <ComboBoxItem Content="qq" />
                                <ComboBoxItem Content="网址" />
                                <ComboBoxItem Content="备注" />
                            </ComboBox>
                            <TextBox Grid.Column="1" Style="{StaticResource StyleAddKeyInput}"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="✕"
                                    Foreground="#888888" FontSize="10"
                                    Width="28" Height="28"
                                    Command="{Binding DataContext.RemoveBindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4A4A4A" />
                                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Row 7: Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Foreground="#CCCCCC"
                    Margin="0,0,10,0" Width="50" Height="32"
                    Style="{StaticResource StyleButton}"
                    Command="{Binding BackCommand}" />
            <Button Content="保存记录" Style="{StaticResource StyleSaveButton}"
                    Foreground="#FFFFFF" Padding="20,6"
                    Cursor="Hand" Command="{Binding SaveCommand}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
