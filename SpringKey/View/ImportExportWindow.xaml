<Window x:Class="SpringKey.View.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据备份与恢复" Height="500" Width="800"
        Background="{StaticResource ThemeColor}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="数据备份与恢复" Foreground="{StaticResource TextForeground}" FontSize="20" FontWeight="SemiBold"/>

        <Border Grid.Row="2" Background="{StaticResource SideBarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource IcoColor}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="导出备份" Foreground="{StaticResource IcoColor}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="选择要导出的用户：" Foreground="#969696" FontSize="13" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="UserName"
                          Width="300" Margin="0,0,0,12"
                          Background="{StaticResource PasswordBackground}" Foreground="{StaticResource IcoColor}"
                          BorderBrush="{StaticResource BorderColor}"/>

                <TextBlock Text="将您当前或选定用户的数据导出为安全的 .skbackup 格式文件。建议您将文件保存在受信任的位置。"
                           Foreground="#969696" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Button HorizontalAlignment="Left" Command="{Binding ExportBackupCommand}"
                        Background="#313131" Foreground="{StaticResource IcoColor}"
                        BorderBrush="#454545" BorderThickness="1"
                        Padding="16,8" Cursor="Hand" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="生成 .skbackup 备份文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SideBarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource IcoColor}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="导入恢复" Foreground="{StaticResource IcoColor}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="从已有的 .skbackup 文件中恢复您的数据。"
                           Foreground="#969696" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="注意：导入操作会将备份中的数据合并到当前列表，重复项将被跳过或覆盖。"
                           Foreground="#E5A638" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Button HorizontalAlignment="Left" Command="{Binding ImportBackupCommand}"
                        Background="#0E639C" Foreground="#FFFFFF"
                        BorderThickness="0" Padding="16,8" Cursor="Hand" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="选择 .skbackup 文件并导入" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
