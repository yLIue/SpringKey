<Window x:Class="SpringKey.View.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入导出" Height="280" Width="400"
        MinHeight="280" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="{StaticResource ThemeColor}"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="备份与恢复" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Foreground="#969696" FontSize="12" Margin="0,0,0,4">
                <Run Text="当前用户："/>
                <Run Text="{Binding UserName}" Foreground="#CCCCCC"/>
            </TextBlock>
            <TextBlock Text="导出该用户的全部数据为 .skbackup 文件，或从备份文件导入恢复。"
                       Foreground="#969696" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="导出备份" Style="{StaticResource StyleSaveButton}"
                    Foreground="White" Width="90" Height="32" Cursor="Hand"
                    Command="{Binding ExportBackupCommand}" Margin="0,0,10,0"/>
            <Button Content="导入恢复" Style="{StaticResource StyleButton}"
                    Foreground="#CCCCCC" Width="90" Height="32"
                    Command="{Binding ImportBackupCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Foreground="#969696" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</Window>
